# Repository-root tokens. Copy to `.env.local` (gitignored) and fill in.
# These are NOT application env vars — the apps have their own
# `apps/*/.env.example`. These exist so scripts and agent sessions can talk
# to Supabase and Vercel without anyone pasting a key by hand.
#
# See docs/TOOLING.md for how to obtain each one.

# Supabase personal access token — used by `scripts/seed-production.sh` to
# fetch project API keys via the Supabase CLI, so no key is ever typed,
# pasted or echoed. Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Vercel access token — lets the `vercel` CLI read and write project
# settings and environment variables non-interactively.
# Create at https://vercel.com/account/settings/tokens
VERCEL_TOKEN=

# Written automatically by `vercel env pull` / `vercel dev`. Do not set by
# hand; it is short-lived and machine-specific.
VERCEL_OIDC_TOKEN=
