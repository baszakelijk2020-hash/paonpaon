{
  "name": "paon",
  "version": "0.0.0",
  "private": true,
  "description": "PAON — RetailOS and customer engagement platform for premium and luxury retailers.",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm validate:completion",
    "test:e2e": "turbo run test:e2e",
    "validate:completion": "pnpm --filter @paon/domain validate:completion",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "paon:delegate": "bash scripts/paon-delegate.sh",
    "paon:run": "bash scripts/paon-run.sh",
    "paon:run:test": "bash scripts/paon-runner.test.sh",
    "paon:start": "bash scripts/paon-session.sh start",
    "paon:status": "bash scripts/paon-session.sh status",
    "paon:stop": "bash scripts/paon-session.sh stop",
    "test:production": "node scripts/production-gate/run.mjs",
    "predeploy:customer": "node scripts/production-gate/preflight.mjs customer",
    "predeploy:retailer": "node scripts/production-gate/preflight.mjs retailer",
    "predeploy:admin": "node scripts/production-gate/preflight.mjs admin"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,mdx,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.18",
      "sharp": ">=0.35.0"
    }
  }
}
