{
  "name": "@paon/database",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate-types": "supabase gen types typescript --local > src/generated/database.types.ts",
    "bootstrap:platform-admin": "tsx scripts/bootstrap-platform-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "deactivate:demo": "tsx scripts/deactivate-demo-logins.ts",
    "reactivate:demo": "tsx scripts/reactivate-demo-logins.ts"
  },
  "dependencies": {
    "@paon/domain": "workspace:*",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "@paon/eslint-config": "workspace:*",
    "@paon/typescript-config": "workspace:*",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
