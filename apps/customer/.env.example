NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Optional — Mission Control CTA on /demo/[token] after access-code unlock.
NEXT_PUBLIC_RETAILER_APP_URL=http://localhost:3001
# Optional — Stripe Connect (see docs/PROJECT_STATE.md "Credentials needed").
# Without them, checkout renders a "payments not available yet" state and
# /api/webhooks/stripe returns 503 instead of failing.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
