{
  "name": "@paon/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PAON Admin — internal platform administration console for PAON staff.",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next dist",
    "dev": "next dev --turbopack -p 3000",
    "lint": "eslint . --max-warnings 0",
    "start": "next start -p 3000",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paon/auth": "workspace:*",
    "@paon/database": "workspace:*",
    "@paon/domain": "workspace:*",
    "@paon/ui": "workspace:*",
    "@paon/utils": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@paon/eslint-config": "workspace:*",
    "@paon/typescript-config": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
