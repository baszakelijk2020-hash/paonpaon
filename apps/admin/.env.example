NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated hosted project refs explicitly classified disposable for
# Playwright. Leave empty for local Supabase; never add the original project.
PAON_DISPOSABLE_SUPABASE_REFS=
NEXT_PUBLIC_RETAILER_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3000
# Optional — Stripe Billing, PAON's own platform account (see
# docs/PROJECT_STATE.md "Credentials needed"). Without them, /billing
# and retailer plan assignment render a "not configured" state and
# /api/webhooks/stripe returns 503 instead of failing.
STRIPE_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
# Optional — Resend transactional email (see docs/PROJECT_STATE.md
# "Credentials needed"). Without them, /api/cron/dispatch-emails
# returns 503 instead of failing; enqueued email just waits in
# email_outbox until both are set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Shared secret the cron dispatch endpoint checks — generate any long
# random string; Vercel sends it automatically as a Bearer token for
# any project with this env var set once cron is configured.
CRON_SECRET=
