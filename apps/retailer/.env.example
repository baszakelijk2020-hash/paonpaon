NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated hosted project refs explicitly classified disposable for
# Playwright. Leave empty for local Supabase; never add the original project.
PAON_DISPOSABLE_SUPABASE_REFS=
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Optional — Stripe Connect (see docs/PROJECT_STATE.md "Credentials needed").
# Without it, /settings/payments renders a "not configured" state instead of failing.
STRIPE_SECRET_KEY=
# Optional — AI personalisation (see docs/PROJECT_STATE.md "Credentials needed").
# Without it, the customer detail page's AI Insights card renders a
# "not configured" state instead of failing.
OPENAI_API_KEY=

# Required by e2e/integration-connection-lifecycle.spec.ts (PHASE 9.2).
E2E_FADEN_WEBHOOK_SECRET=
