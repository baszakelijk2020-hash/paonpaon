# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
# Playwright's isolated e2e Next.js dist dir (apps/*/playwright.config.ts
# PAON_NEXT_DIST_DIR, e.g. `.next-e2e-3102`) — build output, not source.
# Un-ignored once already, and a bulk `git add` from inside an app dir
# during e2e work has landed hundreds of generated files in a commit.
.next-e2e-*/
dist/
build/
out/

# Turborepo
.turbo/

# Testing
coverage/
# `/staff/coverage` is product source, not a test report. The broad rule
# above previously hid the route while its browser proof stayed trackable.
!apps/retailer/app/(dashboard)/staff/coverage/
!apps/retailer/app/(dashboard)/staff/coverage/**
playwright-report/
test-results/
.vitest-cache/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Supabase
supabase/.branches/
supabase/.temp/

# Editor / OS
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Agent tooling — machine-local settings, never shared
.claude/settings.local.json

# Delegation-gate runtime ledger — ephemeral per-session state, not source.
.claude/delegation-state.json
.claude/delegation-audit.log

# Delegated-worker git worktrees and session lock — runtime state created by
# scripts/paon-delegate.sh / paon-session.sh, never source.
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/.DS_Store

# Agent scratch — throwaway verification specs must never be committed.
# Name any temporary Playwright/vitest file with this prefix so it is
# ignored by construction rather than by remembering to delete it.
**/_tmp-*.spec.ts
**/_tmp-*.ts

# Secrets. The negation must stay AFTER the wildcard — an earlier
# `!.env.example` on line 24 was silently overridden by a later bare
# `.env*`, which meant a newly added .env.example would never be tracked
# (the app-level ones survived only because they predated that rule).
.env*
!.env.example
!**/.env.example

# Codex CLI config can embed a live provider API key directly in
# `env_key` instead of an env-var name (seen in practice, not a
# hypothetical) — never let it be committable.
.codex/

# Playwright MCP session cache (screenshots/console logs from ad-hoc
# manual browsing) and MCP-installed skill snapshots — machine-local
# tooling state, never source.
.playwright-mcp/
.agents/

# Ad-hoc root-level verification screenshots dropped by manual browser
# checks — not tracked evidence (that lives under docs/evidence/).
/*.png
