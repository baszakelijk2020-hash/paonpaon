# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
build/
out/

# Turborepo
.turbo/

# Testing
coverage/
# `/staff/coverage` is product source, not a test report. The broad rule
# above previously hid the route while its browser proof stayed trackable.
!apps/retailer/app/(dashboard)/staff/coverage/
!apps/retailer/app/(dashboard)/staff/coverage/**
playwright-report/
test-results/
.vitest-cache/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Supabase
supabase/.branches/
supabase/.temp/

# Editor / OS
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Agent tooling — machine-local settings, never shared
.claude/settings.local.json

# Agent scratch — throwaway verification specs must never be committed.
# Name any temporary Playwright/vitest file with this prefix so it is
# ignored by construction rather than by remembering to delete it.
**/_tmp-*.spec.ts
**/_tmp-*.ts

# Secrets. The negation must stay AFTER the wildcard — an earlier
# `!.env.example` on line 24 was silently overridden by a later bare
# `.env*`, which meant a newly added .env.example would never be tracked
# (the app-level ones survived only because they predated that rule).
.env*
!.env.example
!**/.env.example

# Codex CLI config can embed a live provider API key directly in
# `env_key` instead of an env-var name (seen in practice, not a
# hypothetical) — never let it be committable.
.codex/
